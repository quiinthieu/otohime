DATABASE_URL=postgresql://otohime:otohime@localhost:5433/otohime
BETTER_AUTH_SECRET=
PORT=4000
BETTER_AUTH_URL=http://localhost:4000
# Password-reset email via Resend. Leave the key empty locally: the link is logged instead.
RESEND_API_KEY=
EMAIL_FROM="Otohime <no-reply@otohime.dev>"
# Music's Now playing (lib/now-playing.ts). Leave them empty and the cassette and cartridge stay quiet.
# Optional public owner identity; no token/key. Overrides content/now-playing.ts (empty by default).
# A valid username selects ListenBrainz; an outage stays quiet without Spotify fallback.
LISTENBRAINZ_USER=
# Loopback-only fixture override: NOW_PLAYING_LISTENBRAINZ_HOST=http://127.0.0.1:4134
# Spotify alternative: owner app and refresh token from consent with user-read-currently-playing.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Optional Steam: a Web API key and the owner's 17-digit SteamID64 (profile and game details public).
STEAM_API_KEY=
STEAM_ID=
