{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otohime.dev/schemas/app-manifest.v1.json",
  "title": "Otohime App Manifest",
  "description": "Typed per-application manifest for the /apps workshop showcase on otohime.dev. Dropping a valid <slug>.json file into content/apps/ publishes the app across /apps, /apps/<slug>, OpenGraph, and sitemap without code changes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "tagline",
    "description",
    "platforms",
    "status",
    "swatch",
    "techStack",
    "features",
    "install",
    "links",
    "illustration",
    "milestones",
    "changelog"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "order": {
      "type": "number"
    },
    "featured": {
      "type": "boolean"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "description": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["macos", "cli", "tui", "web", "linux", "ios"]
      }
    },
    "status": {
      "type": "string",
      "enum": ["idea", "planned", "building", "beta", "released"]
    },
    "swatch": {
      "type": "string",
      "enum": ["yellow", "coral", "mint", "blue", "pink"]
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "shape": {
          "type": "string",
          "enum": ["round", "square"]
        }
      }
    },
    "techStack": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "features": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "detail"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "command"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^https://"
        },
        "docs": {
          "type": "string",
          "pattern": "^https://"
        },
        "homebrew": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "cask": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "formula": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        },
        "follow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "href"],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "href": {
              "type": "string",
              "pattern": "^(https://|mailto:)"
            }
          }
        }
      }
    },
    "illustration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "alt"],
          "properties": {
            "kind": {
              "const": "ink"
            },
            "motif": {
              "type": "string",
              "enum": ["bento-box", "bonsai-garden", "ledger-book", "sun-dial", "blueprint"]
            },
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "caption": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "src", "alt", "width", "height"],
          "properties": {
            "kind": {
              "const": "screenshot"
            },
            "src": {
              "type": "string",
              "pattern": "^/(?!/)"
            },
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "caption": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "preview": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "title", "command", "alt"],
          "properties": {
            "kind": {
              "enum": ["niwa-garden", "shiki-drift"]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "alt": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "title", "command", "alt", "frames"],
          "properties": {
            "kind": {
              "const": "frames"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "intervalMs": {
              "type": "integer",
              "minimum": 250,
              "maximum": 60000
            },
            "frames": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "lines"],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "lines": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "milestones": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "state"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "state": {
            "type": "string",
            "enum": ["done", "active", "next"]
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "date", "summary"],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "highlights": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
