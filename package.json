{
  "name": "otohime",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:next": "NODE_OPTIONS=--max-http-header-size=65536 next dev --port 4000",
    "prebuild": "node scripts/vendor-peep-box.mjs && (node scripts/ledger-fetch.mjs || true; node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/history-index.ts)",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "prisma studio --port 4500",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'lib/**/*.test.ts' 'app/(shore)/_lib/*.test.ts' 'app/(ryugu)/_lib/*.test.ts' 'app/(capsule)/_lib/*.test.ts' 'app/(orrery)/_lib/*.test.ts' 'app/(elements)/_lib/*.test.ts' 'app/(vinyl)/_lib/*.test.ts' 'app/(rotor)/_lib/*.test.ts' 'app/(planisphere)/_lib/*.test.ts' 'app/(barometer)/_lib/*.test.ts' 'app/(articles)/_lib/*.test.ts' 'app/(structures)/_lib/*.test.ts' 'app/(design-system)/_lib/*.test.ts' 'app/(site)/(app)/music/_lib/*.test.ts' 'app/(site)/(app)/desk/_lib/*.test.ts' 'app/(site)/(app)/ledger/_lib/*.test.ts' 'scripts/history-index.test.ts' 'scripts/yearly-log.test.ts' 'scripts/e2e-gesture-trace.test.ts' 'scripts/console-errors.test.ts' 'scripts/ci-workflow.test.mjs' 'scripts/e2e-build.test.mjs' 'scripts/probe-browser.test.mjs' 'scripts/probe-end-dom.test.mjs' 'ghosts/*.test.ts' 'scripts/ghosts-fake.test.mjs' 'scripts/ci-probe-annotate.test.mjs' 'scripts/probe-end-stream.test.mjs' 'scripts/main-lane-closure.test.mjs'",
    "test:e2e": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e.mjs --test 'e2e/**/*.test.ts'",
    "test:ghosts-pref": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test e2e/ghosts-pref.test.ts",
    "elements:validate": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'app/(elements)/_lib/facts.test.ts' 'app/(elements)/_lib/elements.test.ts'",
    "elements:vendor": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/vendor-elements.ts",
    "planisphere:vendor": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/vendor-planisphere.ts",
    "capsule:sheet": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/capsule-sheet.ts",
    "vinyl:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/vinyl-check.ts",
    "sketches:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sketches-check.ts",
    "portraits:handoff:export": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sketches-handoff.ts export",
    "portraits:handoff:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sketches-handoff.ts check",
    "ask:index": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ask-index.ts",
    "ask:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ask-index.ts --check",
    "peeks:index": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/peeks-index.ts",
    "radio:vendor": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/vendor-radio.ts",
    "radio:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/vendor-radio.ts --check",
    "peeks:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/peeks-index.ts --check",
    "history:index": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/history-index.ts",
    "history:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/history-index.ts --check",
    "yearly-log:index": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/yearly-log.ts",
    "yearly-log:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/yearly-log.ts --check",
    "hanafuda:verify": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-hanafuda-engine.mjs",
    "peep-box:vendor": "node scripts/vendor-peep-box.mjs",
    "peep-box:verify": "node scripts/verify-peep-box-camera.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@mediapipe/tasks-vision": "0.10.32",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "roughjs": "4.6.6",
    "sharp": "0.35.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright-core": "1.64.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
