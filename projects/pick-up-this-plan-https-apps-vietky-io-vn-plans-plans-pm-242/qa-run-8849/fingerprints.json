  "workflow_log": "841ca69 pm-258/t-1564: Annotate failed E2E tests in CI and add a flowing-clock control to Kame's hold threshold\n",
  "workflow_diff": "diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\nindex f5de232..cb3523d 100644\n--- a/.github/workflows/ci.yml\n+++ b/.github/workflows/ci.yml\n@@ -73,11 +73,29 @@ jobs:\n           test -z \"$(git status --porcelain db/migrations)\"\n       - run: npm run build\n       - run: npm run db:migrate\n+      # The job log needs a token to read: a failed test is also an annotation and a step summary section\n+      # (scripts/e2e-annotate.mjs), and a red step adds the server's last lines there, with what ran.\n       - name: E2E against next start\n         run: |\n-          npm start &\n+          npm start >\"$RUNNER_TEMP/next-start.log\" 2>&1 &\n           curl -fsS --retry 30 --retry-connrefused --retry-delay 1 \"$BASE_URL/api/health\"\n-          npm run test:e2e\n+          status=0\n+          npm run test:e2e || status=$?\n+          if [ \"$status\" -ne 0 ]; then\n+            {\n+              echo \"## E2E environment\"\n+              echo\n+              echo \"- commit $GITHUB_SHA, build $(cat .next/BUILD_ID), node $(node -v), $(google-chrome --version 2>/dev/null || echo 'no google-chrome'), $(nproc) CPUs\"\n+              echo\n+              echo \"### next start, last 80 lines\"\n+              echo\n+              echo '```'\n+              tail -n 80 \"$RUNNER_TEMP/next-start.log\" | sed 's/```/\u02cb\u02cb\u02cb/g'\n+              echo '```'\n+            } >>\"$GITHUB_STEP_SUMMARY\"\n+            tail -n 80 \"$RUNNER_TEMP/next-start.log\"\n+          fi\n+          exit \"$status\"\n       # Signs in through the form against the same server and database, so a page error on the hop into a\n       # signed-in room turns the job red. It signs up and deletes its own *-<run>@probe.test accounts.\n       - name: Motion probe, signed in\n",
